<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="KytyPS5Launcher.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Padding="32" Spacing="20" MaxWidth="720">
            <StackPanel Spacing="6">
                <TextBlock Text="KytyPS5" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Text="Manage your Windows x64 installation" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
            </StackPanel>
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel Spacing="14">
                    <TextBlock Text="Installation" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <Grid ColumnSpacing="20" RowSpacing="10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Text="Installed" />
                        <TextBlock x:Name="InstalledText" Grid.Column="1" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="1" Text="Most recent" />
                        <TextBlock x:Name="LatestText" Grid.Row="1" Grid.Column="1" Text="Not checked" TextWrapping="Wrap" />
                    </Grid>
                    <TextBlock x:Name="LocationText" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" />
                    <Button x:Name="ChangeFolderButton" Content="Change folder" Click="ChangeFolder_Click" AutomationProperties.AutomationId="ChangeFolderButton" />
                </StackPanel>
            </Border>
            <StackPanel Spacing="8">
                <ComboBox x:Name="ReleaseSelector" Header="Release" PlaceholderText="Check for releases" HorizontalAlignment="Stretch" SelectionChanged="Release_SelectionChanged" AutomationProperties.AutomationId="ReleaseSelector" />
                <TextBlock x:Name="ReleaseAvailabilityText" TextWrapping="Wrap" />
                <Button x:Name="MoreButton" Content="Load older releases" Click="More_Click" IsEnabled="False" AutomationProperties.AutomationId="LoadOlderReleasesButton" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="CheckButton" Content="Check for updates" Click="Check_Click" AutomationProperties.AutomationId="CheckUpdatesButton" />
                <Button x:Name="InstallButton" Content="Install" Click="Install_Click" IsEnabled="False" Style="{StaticResource AccentButtonStyle}" AutomationProperties.AutomationId="InstallUpdateButton" />
                <Button x:Name="LaunchButton" Content="Launch KytyPS5" Click="Launch_Click" IsEnabled="False" AutomationProperties.AutomationId="LaunchButton" />
            </StackPanel>
            <StackPanel Spacing="8">
                <TextBlock x:Name="ProgressText" Text="Check for a release to get started." TextWrapping="Wrap" />
                <ProgressBar x:Name="Progress" Minimum="0" Maximum="100" Visibility="Collapsed" />
            </StackPanel>
            <InfoBar x:Name="Notice" IsOpen="False" IsClosable="True" />
            <TextBlock Text="Updates are installed only when you choose Install or Update. Close KytyPS5 and any running games first. Disable KytyPS5's own automatic updater to manage updates here." TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" />
        </StackPanel>
    </ScrollViewer>
</Page>
